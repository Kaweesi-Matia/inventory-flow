# PostgreSQL
# Docker Compose: host is `postgres`. Local (non-Docker) backend: use `localhost`.
POSTGRES_USER=supplychainx
POSTGRES_PASSWORD=supplychainx
POSTGRES_DB=supplychainx
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://supplychainx:supplychainx@postgres:5432/supplychainx

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: also set CORS_ORIGINS to your Vercel URL, e.g. https://your-app.vercel.app
# Preview deploys are already allowed via CORS_ORIGIN_REGEX in code.

# Render-only (do not set locally unless you want demo data on every start)
# SEED_ON_START=false
